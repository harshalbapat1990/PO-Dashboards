@inherits ErrorBoundary

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="alert alert-danger d-flex align-items-start gap-3 mt-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        <div>
            <h5 class="alert-heading mb-1">Something went wrong</h5>
            <p class="mb-2 small text-muted">@CurrentException.Message</p>
            <button class="btn btn-sm btn-outline-danger" @onclick="Recover">Try again</button>
        </div>
    </div>
}
