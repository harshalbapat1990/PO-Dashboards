                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="apps">
                        <span class="bi bi-grid-fill" aria-hidden="true"></span> Applications
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="github">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Github
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="repos">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Repositories
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="pocs">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> PoCs
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

