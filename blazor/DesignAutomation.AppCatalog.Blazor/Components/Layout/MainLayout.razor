@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <GlobalSearch />
                </Authorized>
            </AuthorizeView>
            <a href="account" class="ms-auto">Account</a>
        </div>

        <article class="content px-4">
            <AppErrorBoundary>
                @Body
            </AppErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
