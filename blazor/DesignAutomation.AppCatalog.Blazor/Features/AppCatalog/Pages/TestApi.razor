@page "/test-api"

@using DesignAutomation.AppCatalog.Blazor.Services.Api
@inject AppCatalogApiClient Api

<h3>API Test</h3>

<button class="btn btn-primary"
        @onclick="PingApi">
    Ping API
</button>

<p>@Message</p>

@code
{
    private string Message = "Not tested";

    private async Task PingApi()
    {
        try
        {
            var r = await Api.PingAsync("Hello Blazor");
            Message = r.IsSuccess ? r.ResultObject ?? string.Empty : r.ResultCode.ToString();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
    }
}