@page "/app/create"
@attribute [Authorize]
@inject AppCatalogApiClient ApiClient
@inject NavigationManager Navigation

<PageHeader Title="Create Application" />

<AppForm Model="_model"
         OnSubmit="SaveAsync"
         Saving="_saving"
         Error="_error"
         SubmitLabel="Create"
         CancelHref="/apps" />

@code {
    private readonly AppHeaderForm _model = new();
    private bool _saving;
    private string? _error;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var result = await ApiClient.InsertAppAsync(_model.ToAppHeader());

            if (result.IsSuccess && result.ResultObject != Guid.Empty)
                Navigation.NavigateTo($"/app/{result.ResultObject}");
            else
                _error = $"Create failed: {result.ResultCode}";
        }
        catch (ApiException ex)
        {
            _error = $"Request failed ({(int)ex.StatusCode}): {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
