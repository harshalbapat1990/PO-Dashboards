@page "/github"
@attribute [Authorize]
@inject AppCatalogApiClient ApiClient

<PageHeader Title="GitHub Repositories">
    <Actions>
        <RefreshButton OnClick="LoadAsync" Disabled="_loading" />
    </Actions>
</PageHeader>

<DataTable TItem="ReadmeDTO"
           Items="_repos"
           Loading="_loading"
           Error="_error"
           SearchPredicate="@((r, s) => r.RepoName.Contains(s, StringComparison.OrdinalIgnoreCase))"
           SearchPlaceholder="Search by name..."
           EmptyMessage="No repositories found."
           LoadingText="Loading repositories...">
    <HeaderTemplate>
        <tr>
            <th>Repository</th>
            <th>ID</th>
            <th>Last Updated</th>
        </tr>
    </HeaderTemplate>
    <RowTemplate Context="repo">
        <tr>
            <td><a href="/github/@repo.ID">@repo.RepoName</a></td>
            <td class="text-muted small">@repo.ID</td>
            <td>@repo.Timestamp.ToString("yyyy-MM-dd")</td>
        </tr>
    </RowTemplate>
</DataTable>

@code {
    private List<ReadmeDTO> _repos = [];
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var result = await ApiClient.GetGithubReposAsync();

            _repos = result.IsSuccess && result.ResultObject is not null
                ? result.ResultObject
                : [];

            if (!result.IsSuccess)
                _error = $"API returned: {result.ResultCode}";
        }
        catch (ApiException ex)
        {
            _error = $"Request failed ({(int)ex.StatusCode}): {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}