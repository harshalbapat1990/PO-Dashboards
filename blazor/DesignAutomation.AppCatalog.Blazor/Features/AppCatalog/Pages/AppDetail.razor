@page "/app/{Id:guid}"
@attribute [Authorize]
@inject AppCatalogApiClient ApiClient
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-0">@(_app?.FullName ?? "Application")</h3>
    <AuthorizeView Roles="Admin">
        <div class="d-flex gap-2">
            <a href="/app/edit/@Id" class="btn btn-outline-primary btn-sm">Edit</a>
            <a href="/app/review/@Id" class="btn btn-outline-secondary btn-sm">Review</a>
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showConfirm = true">Delete</button>
        </div>
    </AuthorizeView>
</div>

<ConfirmDialog Visible="_showConfirm"
               Title="Delete Application"
               Message="@($"Delete '{_app?.FullName}'? This cannot be undone.")"
               ConfirmLabel="Delete"
               OnConfirm="DeleteAsync"
               OnCancel="() => _showConfirm = false" />

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 my-3">
        <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
        <span>Loading...</span>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else if (_app is not null)
{
    <div class="row g-4">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">Metadata</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">App Type</dt>
                        <dd class="col-sm-8">@(_app.AppType is { Length: > 0 } t ? t : "—")</dd>

                        <dt class="col-sm-4">Production</dt>
                        <dd class="col-sm-8">
                            @if (_app.Production)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Availability</dt>
                        <dd class="col-sm-8"><span class="badge bg-light text-dark border">@_app.Availability</span></dd>

                        @if (!string.IsNullOrEmpty(_app.ProductionBranch))
                        {
                            <dt class="col-sm-4">Branch</dt>
                            <dd class="col-sm-8"><code>@_app.ProductionBranch</code></dd>
                        }

                        <dt class="col-sm-4">Score</dt>
                        <dd class="col-sm-8">@_app.Score</dd>

                        <dt class="col-sm-4">Last Modified</dt>
                        <dd class="col-sm-8">@_app.Modified.ToString("yyyy-MM-dd HH:mm")</dd>
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_app.Description))
            {
                <div class="card mb-3">
                    <div class="card-header">Description</div>
                    <div class="card-body">@_app.Description</div>
                </div>
            }

            @if (_app.Team.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Team</div>
                    <div class="card-body d-flex flex-wrap gap-2">
                        @foreach (var member in _app.Team)
                        {
                            <span class="badge bg-secondary">@member</span>
                        }
                    </div>
                </div>
            }

            @if (_app.DocLinks.Count > 0 || _app.PMLinks.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Links</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var link in _app.PMLinks)
                        {
                            <li class="list-group-item"><a href="@link" target="_blank" rel="noopener noreferrer">@link</a></li>
                        }
                        @foreach (var link in _app.DocLinks)
                        {
                            <li class="list-group-item"><a href="@link" target="_blank" rel="noopener noreferrer">@link</a></li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(_app.ReviewURL))
            {
                <div class="card mb-3">
                    <div class="card-header">Review</div>
                    <div class="card-body">
                        <a href="@_app.ReviewURL" target="_blank" rel="noopener noreferrer">Open Review</a>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(_app.WebSite))
            {
                <div class="card mb-3">
                    <div class="card-header">Website</div>
                    <div class="card-body">
                        <a href="@_app.WebSite" target="_blank" rel="noopener noreferrer">@_app.WebSite</a>
                    </div>
                </div>
            }

            @if (_page is not null && _page.Total > 1)
            {
                <div class="card mb-3">
                    <div class="card-header">Navigation</div>
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="NavPrev"
                                disabled="@(_page.Previous == _page.Current)">
                            &#8592; Prev
                        </button>
                        <small class="text-muted">@_page.Total apps</small>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="NavNext"
                                disabled="@(_page.Next == _page.Current)">
                            Next &#8594;
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<a href="/apps" class="btn btn-outline-secondary btn-sm mt-2">&#8592; Back to Applications</a>

@code {
    [Parameter] public Guid Id { get; set; }

    private AppHeader? _app;
    private AppPageDTO? _page;
    private bool _loading;
    private string? _error;
    private bool _showConfirm;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            var appTask  = ApiClient.GetAppAsync(Id);
            var pageTask = ApiClient.GetPageAsync(Id);

            await Task.WhenAll(appTask, pageTask);

            var appResult  = await appTask;
            var pageResult = await pageTask;

            if (appResult.IsSuccess)
                _app = appResult.ResultObject;
            else
                _error = $"API returned: {appResult.ResultCode}";

            if (pageResult.IsSuccess)
                _page = pageResult.ResultObject;
        }
        catch (ApiException ex)
        {
            _error = $"Request failed ({(int)ex.StatusCode}): {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void NavPrev() => Navigation.NavigateTo($"/app/{_page!.Previous}");
    private void NavNext() => Navigation.NavigateTo($"/app/{_page!.Next}");

    private async Task DeleteAsync()
    {
        _showConfirm = false;

        try
        {
            var result = await ApiClient.DeleteAppAsync(Id);

            if (result.IsSuccess && result.ResultObject)
                Navigation.NavigateTo("/apps");
            else
                _error = $"Delete failed: {result.ResultCode}";
        }
        catch (ApiException ex)
        {
            _error = $"Request failed ({(int)ex.StatusCode}): {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
