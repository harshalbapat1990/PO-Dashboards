@page "/repos"
@attribute [Authorize]
@inject AppCatalogApiClient ApiClient

<PageHeader Title="Repositories">
    <Actions>
        <RefreshButton OnClick="LoadAsync" Disabled="_loading" />
    </Actions>
</PageHeader>

<LoadingSpinner Visible="_loading" Text="Loading repositories..." />
<ErrorMessage Message="_error" />

@if (!_loading && _error is null)
{
    @if (_sorted.Count == 0)
    {
        <EmptyState Message="No repositories found." />
    }
    else
    {
        <DataTable TItem="RepoDTO"
                   Items="_sorted"
                   SearchPredicate="@((r, s) => r.App.Contains(s, StringComparison.OrdinalIgnoreCase) || r.Link.Contains(s, StringComparison.OrdinalIgnoreCase))"
                   SearchPlaceholder="Search by app or link..."
                   EmptyMessage="No repositories found.">
            <HeaderTemplate>
                <tr>
                    <th>
                        <button class="btn btn-link p-0 text-decoration-none" @onclick="@(() => SortBy(SortColumn.App))">
                            Application @(SortIndicator(SortColumn.App))
                        </button>
                    </th>
                    <th>
                        <button class="btn btn-link p-0 text-decoration-none" @onclick="@(() => SortBy(SortColumn.Link))">
                            Repository @(SortIndicator(SortColumn.Link))
                        </button>
                    </th>
                </tr>
            </HeaderTemplate>
            <RowTemplate Context="repo">
                <tr>
                    <td><a href="/app/@repo.AppID">@repo.App</a></td>
                    <td>
                        @if (!string.IsNullOrEmpty(repo.Link))
                        {
                            <a href="@repo.Link" target="_blank" rel="noopener noreferrer">@repo.Link</a>
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                </tr>
            </RowTemplate>
        </DataTable>
    }
}

@code {
    private enum SortColumn { App, Link }

    private List<RepoDTO> _repos = [];
    private bool _loading;
    private string? _error;
    private SortColumn _sort = SortColumn.App;
    private bool _sortDesc;

    private List<RepoDTO> _sorted
    {
        get
        {
            IEnumerable<RepoDTO> query = _sort == SortColumn.App
                ? (_sortDesc ? _repos.OrderByDescending(r => r.App) : _repos.OrderBy(r => r.App))
                : (_sortDesc ? _repos.OrderByDescending(r => r.Link) : _repos.OrderBy(r => r.Link));

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var result = await ApiClient.GetReposAsync();

            _repos = result.IsSuccess && result.ResultObject is not null
                ? result.ResultObject
                : [];

            if (!result.IsSuccess)
                _error = $"API returned: {result.ResultCode}";
        }
        catch (ApiException ex)
        {
            _error = $"Request failed ({(int)ex.StatusCode}): {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SortBy(SortColumn column)
    {
        if (_sort == column)
            _sortDesc = !_sortDesc;
        else
        {
            _sort = column;
            _sortDesc = false;
        }
    }

    private string SortIndicator(SortColumn column) =>
        _sort == column ? (_sortDesc ? "↓" : "↑") : string.Empty;
}