@page "/api-test"

@inject DesignAutomation.AppCatalog.Blazor.Services.Api.AppCatalogApiClient Api

<h3>API Test</h3>

<button class="btn btn-primary"
        @onclick="Ping">
    Ping API
</button>

<button class="btn btn-secondary ms-2"
        @onclick="Authenticate">
    Authenticate
</button>

<hr />

<pre>@Result</pre>

@code
{
    private string Result = "Ready";

    private async Task Ping()
    {
        try
        {
            var r = await Api.PingAsync("Hello Blazor");
            Result = r.IsSuccess ? r.ResultObject ?? string.Empty : r.ResultCode.ToString();
        }
        catch (Exception ex)
        {
            Result = ex.ToString();
        }
    }

    private async Task Authenticate()
    {
        try
        {
            var r = await Api.AuthenticateAsync();
            Result = r.IsSuccess ? r.ResultObject.ToString() : r.ResultCode.ToString();
        }
        catch (Exception ex)
        {
            Result = ex.ToString();
        }
    }
}