@page "/github/{Id:long}"
@attribute [Authorize]
@inject AppCatalogApiClient ApiClient

<h3>@(_data?.Name is { Length: > 0 } n ? n : _data?.RepoName ?? "Repository")</h3>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 my-3">
        <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
        <span>Loading...</span>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else if (_data is not null)
{
    <div class="row g-4">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">Metadata</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Repository</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(_data.URL))
                            {
                                <a href="@_data.URL" target="_blank" rel="noopener noreferrer">@_data.RepoName</a>
                            }
                            else { @_data.RepoName }
                        </dd>
                        @if (!string.IsNullOrEmpty(_data.Description))
                        {
                            <dt class="col-sm-4">Description</dt>
                            <dd class="col-sm-8">@_data.Description</dd>
                        }
                        @if (!string.IsNullOrEmpty(_data.ProductionBranch))
                        {
                            <dt class="col-sm-4">Production Branch</dt>
                            <dd class="col-sm-8"><code>@_data.ProductionBranch</code></dd>
                        }
                        <dt class="col-sm-4">Production</dt>
                        <dd class="col-sm-8">
                            @if (_data.IsProduction)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </dd>
                        @if (_data.Uptime > 0)
                        {
                            <dt class="col-sm-4">Uptime Target</dt>
                            <dd class="col-sm-8">@_data.Uptime.ToString("P2")</dd>
                        }
                        @if (_data.Score > 0)
                        {
                            <dt class="col-sm-4">Score</dt>
                            <dd class="col-sm-8">@_data.Score</dd>
                        }
                    </dl>
                </div>
            </div>

            @if (_data.TechStack.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Tech Stack</div>
                    <div class="card-body d-flex flex-wrap gap-2">
                        @foreach (var tech in _data.TechStack)
                        {
                            <span class="badge bg-primary">@tech</span>
                        }
                    </div>
                </div>
            }

            @if (_data.Documents.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Documentation</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var doc in _data.Documents)
                        {
                            <li class="list-group-item">
                                <a href="@doc.URL" target="_blank" rel="noopener noreferrer">
                                    @(doc.Label is { Length: > 0 } ? doc.Label : doc.URL)
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (_data.Branches.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Branches</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var branch in _data.Branches)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <code>@branch.Name</code>
                                <small class="text-muted">@branch.Timestamp.ToString("yyyy-MM-dd")</small>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="col-md-4">
            @if (_data.Team.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Team</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var member in _data.Team)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <span>@member.Name</span>
                                @if (!string.IsNullOrEmpty(member.Role))
                                {
                                    <small class="text-muted">@member.Role</small>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="card mb-3">
                <div class="card-header">Links</div>
                <div class="card-body">
                    @if (_data.WebSite is { URL: { Length: > 0 } } ws)
                    {
                        <div><a href="@ws.URL" target="_blank" rel="noopener noreferrer">
                            @(ws.Label is { Length: > 0 } ? ws.Label : "Website")
                        </a></div>
                    }
                    @if (_data.ProjectManagement is { URL: { Length: > 0 } } pm)
                    {
                        <div><a href="@pm.URL" target="_blank" rel="noopener noreferrer">
                            @(pm.Label is { Length: > 0 } ? pm.Label : "Project Board")
                        </a></div>
                    }
                    @if (_data.WebSite is null && _data.ProjectManagement is null)
                    {
                        <span class="text-muted">No links available.</span>
                    }
                </div>
            </div>

            @if (_data.Integrations.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Integrations</div>
                    <div class="card-body d-flex flex-wrap gap-2">
                        @foreach (var api in _data.Integrations)
                        {
                            <span class="badge bg-info text-dark">@api</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<a href="/github" class="btn btn-outline-secondary btn-sm mt-2">&#8592; Back to List</a>

@code {
    [Parameter] public long Id { get; set; }

    private ReadmeData? _data;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            var result = await ApiClient.GetGithubRepoAsync(Id);

            if (result.IsSuccess)
                _data = result.ResultObject;
            else
                _error = $"API returned: {result.ResultCode}";
        }
        catch (ApiException ex)
        {
            _error = $"Request failed ({(int)ex.StatusCode}): {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
