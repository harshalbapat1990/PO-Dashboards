@page "/account"
@attribute [Authorize]
@inject AuthService AuthSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageHeader Title="Account" />

@if (_token is null)
{
    <LoadingSpinner Text="Loading account..." />
}
else
{
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Profile</div>
                <div class="card-body d-flex align-items-start gap-3">
                    @if (!string.IsNullOrEmpty(_token.Picture))
                    {
                        <img src="@_token.Picture" alt="Profile" class="rounded-circle"
                             width="64" height="64"
                             style="object-fit:cover;" />
                    }
                    <dl class="row mb-0 flex-grow-1">
                        <dt class="col-sm-4">User ID</dt>
                        <dd class="col-sm-8 text-break">
                            <code>@(_token.UserId ?? "—")</code>
                        </dd>

                        <dt class="col-sm-4">Role</dt>
                        <dd class="col-sm-8">
                            <RoleBadge Role="@(_token.Role ?? string.Empty)" />
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Session</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Token Expires</dt>
                        <dd class="col-sm-7">
                            @_token.Expires.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                            @if (_token.Expires < DateTimeOffset.UtcNow.AddHours(1))
                            {
                                <span class="badge bg-warning text-dark ms-1">Expiring soon</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Valid</dt>
                        <dd class="col-sm-7">
                            @if (_token.IsValid)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-outline-danger" @onclick="LogoutAsync">Logout</button>
    </div>
}

@code {
    private AuthToken? _token;

    protected override async Task OnInitializedAsync()
    {
        _token = await AuthSvc.GetCurrentUserAsync();
    }

    private async Task LogoutAsync()
    {
        if (AuthState is AppAuthenticationStateProvider provider)
            await provider.LogoutAsync();
        else
            await AuthSvc.LogoutAsync();

        Navigation.NavigateTo("/login");
    }
}