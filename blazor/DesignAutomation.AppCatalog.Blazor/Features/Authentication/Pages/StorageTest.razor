@page "/storage-test"

@inject DesignAutomation.AppCatalog.Blazor.Services.Storage.ITokenStorage TokenStorage

<h3>Storage Test</h3>

<button class="btn btn-success me-2"
        @onclick="SaveToken">
    Save Token
</button>

<button class="btn btn-primary me-2"
        @onclick="GetToken">
    Get Token
</button>

<button class="btn btn-danger me-2"
        @onclick="DeleteToken">
    Delete Token
</button>

<p>@Message</p>

@code {
    private string Message = "Ready";

    private async Task SaveToken()
    {
        await TokenStorage.SetTokenAsync("test-jwt-token");
        Message = "Token saved";
    }

    private async Task GetToken()
    {
        var token = await TokenStorage.GetTokenAsync();

        Message = token ?? "No token found";
    }

    private async Task DeleteToken()
    {
        await TokenStorage.DeleteTokenAsync();

        Message = "Token deleted";
    }
}