@page "/dashboard"
@attribute [Authorize]
@inject DashboardService DashboardSvc

<PageHeader Title="Dashboard">
    <Actions>
        @if (_metrics is not null)
        {
            <span class="text-muted small align-self-center">
                Last refreshed @_metrics.GeneratedAt.LocalDateTime.ToString("HH:mm:ss")
            </span>
        }
        <RefreshButton OnClick="LoadAsync" Disabled="_loading" />
    </Actions>
</PageHeader>

<DashboardSection Title="Overview" Loading="_loading" Error="_error" LoadingText="Loading metrics...">
    <DashboardGrid Columns="5">
        <KpiCard Title="Total Apps" Value="@($"{_metrics?.TotalApps ?? 0}")" Icon="bi-grid-fill" Color="primary" />
        <KpiCard Title="Production" Value="@($"{_metrics?.ProductionApps ?? 0}")" Icon="bi-check-circle-fill" Color="success" />
        <KpiCard Title="Repositories" Value="@($"{_metrics?.Repositories ?? 0}")" Icon="bi-git" Color="dark" />
        <KpiCard Title="PoCs" Value="@($"{_metrics?.PoCs ?? 0}")" Icon="bi-lightbulb-fill" Color="warning" />
        <KpiCard Title="Users" Value="@($"{_metrics?.Users ?? 0}")" Icon="bi-people-fill" Color="info" />
    </DashboardGrid>
</DashboardSection>

<DashboardSection Title="Portfolio Health" Loading="_loading" Error="_error">
    @if (_metrics is not null)
    {
        <div class="row g-3">
            <div class="col-md-6">
                <div class="d-flex flex-column gap-2">
                    <MetricTile Label="Production Apps" Value="@($"{_metrics.ProductionApps}")" Badge="Prod" BadgeColor="success" />
                    <MetricTile Label="Non-Production Apps" Value="@($"{_metrics.NonProductionApps}")" Badge="Non-Prod" BadgeColor="secondary" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Availability Distribution</div>
                    <ul class="list-group list-group-flush">
                        @if (_metrics.AvailabilityDistribution.Count == 0)
                        {
                            <li class="list-group-item text-muted">No data.</li>
                        }
                        else
                        {
                            @foreach (var kv in _metrics.AvailabilityDistribution.OrderByDescending(k => k.Value))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @kv.Key
                                    <span class="badge bg-primary rounded-pill">@kv.Value</span>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</DashboardSection>

@code {
    private DashboardMetrics? _metrics;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        DashboardSvc.Refresh();
        StateHasChanged();

        try
        {
            _metrics = await DashboardSvc.GetMetricsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
