@page "/product-health"
@attribute [Authorize]
@inject ProductHealthService HealthSvc

<PageHeader Title="Product Health" />

@if (_loading)
{
    <LoadingSpinner Text="Loading health data..." />
}
else if (_error is not null)
{
    <ErrorMessage Message="@_error" />
}
else if (_metrics is not null)
{
    <DashboardGrid Columns="4">
        <KpiCard Title="Total Apps" Value="@_metrics.TotalApps.ToString()" Icon="bi-grid" Color="primary" Loading="false" />
        <KpiCard Title="Production" Value="@_metrics.HealthyApps.ToString()" Icon="bi-check-circle" Color="success" Loading="false" />
        <KpiCard Title="Degraded" Value="@_metrics.DegradedApps.ToString()" Icon="bi-exclamation-triangle" Color="warning" Loading="false" />
        <KpiCard Title="Unknown" Value="@_metrics.UnknownApps.ToString()" Icon="bi-question-circle" Color="secondary" Loading="false" />
    </DashboardGrid>

    <p class="text-muted small mt-3">Last refreshed: @_metrics.GeneratedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</p>
}

@code {
    private ProductHealthMetrics? _metrics;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _metrics = await HealthSvc.GetMetricsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
